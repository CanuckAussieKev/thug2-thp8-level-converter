{
  "name": "thug2-thp8-level-converter",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "description": "THUG2 THP8 Level Converter: Tony Hawk's Project 8 (Xbox 360) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thp8-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./thp8/dxt.ts": {
      "types": "./thp8/dxt.ts",
      "default": "./thp8/dxt.js"
    },
    "./thp8/geom.ts": {
      "types": "./thp8/geom.ts",
      "default": "./thp8/geom.js"
    },
    "./thp8/havok.ts": {
      "types": "./thp8/havok.ts",
      "default": "./thp8/havok.js"
    },
    "./thp8/materials.ts": {
      "types": "./thp8/materials.ts",
      "default": "./thp8/materials.js"
    },
    "./thp8/render_audit.ts": {
      "types": "./thp8/render_audit.ts",
      "default": "./thp8/render_audit.js"
    },
    "./thp8/thp8.ts": {
      "types": "./thp8/thp8.ts",
      "default": "./thp8/thp8.js"
    },
    "./thp8/thp8_levels.ts": {
      "types": "./thp8/thp8_levels.ts",
      "default": "./thp8/thp8_levels.js"
    },
    "./thp8/xenos.ts": {
      "types": "./thp8/xenos.ts",
      "default": "./thp8/xenos.js"
    },
    "./package.json": "./package.json"
  },
  "commands": [
    "thp8/hole_audit.ts",
    "thp8/render_audit.ts",
    "thp8/thp8_levels.ts",
    "thp8_levels/alpha_census.ts",
    "thp8_levels/edge_audit.ts",
    "thp8_levels/env_census.ts",
    "thp8_levels/thp8_levels.ts",
    "thp8_save/thp8_save.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#0c5e0d77a97debf79558e36d2ff118fd6c2affeb",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#7e399b2343d1556166c8106d28dc43d14397bb5c"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
